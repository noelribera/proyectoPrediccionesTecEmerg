# Raíz del proyecto Backend
.gitignore

# Entornos virtuales de Python (venv)
**/venv/
**/env/
**/.venv/
**/ENV/

# Archivos de caché de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Archivos de entornos virtuales de Pipenv
#   Por defecto estos archivos se ignoran en .gitignore de Pipenv
#   https://github.com/pypa/pipenv/issues/598
Pipfile
Pipfile.lock

# Archivos de poetry
poetry.lock

# pyenv
.python-version

# Entornos virtuales de pip
venv.bak/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# Archivos de configuración de IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Archivos de Docker
Dockerfile
docker-compose.override.yml
*.dockerignore

# Variables de entorno
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Backup de archivos
*.bak
*.backup

# Archivos de sistema
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db

# Archivos temporales
*.tmp
*.temp

# Archivos de cobertura
.coverage
htmlcov/
.coverage.*
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# Archivos de configuración específicos del proyecto
# (agrega aquí archivos de configuración local que no deban compartirse)

# Directorios de test y debug
test_output/
debug/
.local/

# Archivos de base de datos SQLite (si los usas)
*.sqlite3
*.db

# Archivos de caché específicos del sistema operativo
# Linux
*~
.fuse_hidden*

# KDE directory preferences
.directory

# Archivos temporales de Linux
.nfs.*

# Windows
# Directorios de instalación de Windows
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Archivos de usuario de Windows
[Tt]humbs.db
Desktop.ini

# Archivos de caché de Recycle Bin
$RECYCLE.BIN/

# Archivos de hibernación de Windows
hiberfil.sys
pagefile.sys
swapfile.sys

# Directorios de compilación/instalación
[Bb]uild/
[Dd]ist/
[Oo]ut/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# PyCharm
.idea/*
!.idea/runConfigurations/
!.idea/inspectionProfiles/
.idea/workspace.xml
.idea/tasks.xml
.idea/dictionaries/
.idea/shelf/
.idea/.gitignore

# Archivos de proyecto específicos (pueden variar)
# Para evitar subir docker-compose.yml si es solo para desarrollo local
# !docker-compose.yml  # Descomenta si quieres mantenerlo en el repo

# Nota: Los archivos requirements.txt y main.py SÍ se subirán al repo
# ya que no están incluidos en este .gitignore